{title:'Digital life',sub:'Broad patterns only. These answers are used for the simulation, not for judgment.',questions:[{id:'social',tag:'Signal 06 / social',text:'How often do you use social media?',opts:['Very low','Low','Moderate','High','Very high']},{id:'notify',tag:'Signal 07 / signal noise',text:'How do you respond to notifications?',opts:['Usually ignore them','Check occasionally','Frequently check','Almost always check']},{id:'create',tag:'Signal 08 / making',text:'How often do you create something digitally?',opts:['Rarely','Sometimes','Often','Almost every day']}]},
{title:'Goals',sub:'Choose what matters to the fictional future you want to explore.',questions:[{id:'goals',tag:'Signal 09 / north star',text:'What matters most to your future? Choose up to four.',multi:['Knowledge','Creativity','Career','Financial independence','Helping people','Innovation','Leadership','Adventure','Stability','Personal growth']},{id:'goalWork',tag:'Signal 10 / momentum',text:'How strongly are you currently working toward your goals?',range:true}]},
{title:'Decision making',sub:'Hypothetical choices reveal only the path you selected in this simulation.',questions:[{id:'free',tag:'Signal 11 / two hours',text:'You have two hours free. What pulls you first?',opts:['Learn something new','Work on an existing project','Relax','Socialize','Explore something random']},{id:'approach',tag:'Signal 12 / pivot',text:'Your current approach is not working. You…',opts:['Persist','Change strategy','Ask for help','Research','Start over']}]},
{title:'Curiosity',sub:'Curiosity is represented here as an invented simulation dimension, not a psychological assessment.',questions:[{id:'curiosity',tag:'Signal 13 / open loop',text:'How often do you explore things simply because you are curious?',range:true}]},
{title:'Risk & exploration',sub:'Balanced scenarios help the model create alternative educational trajectories.',questions:[{id:'risk',tag:'Signal 14 / unfamiliar',text:'Would you try an unfamiliar project if failure was likely?',opts:['Not likely','Maybe, with a plan','Probably','Yes, gladly']},{id:'breadth',tag:'Signal 15 / depth',text:'Would you rather master one skill or explore five?',opts:['Master one','Mostly depth','A balance','Mostly breadth','Explore five']}]},
{title:'Reflection',sub:'A small prompt for the path you want to experiment with. Keep it non-sensitive.',questions:[{id:'improve',tag:'Signal 16 / intention',text:'What would you most like to improve?',opts:['Focus','Creativity','Consistency','Knowledge','Time management','Confidence','Curiosity','Collaboration']},{id:'nickname',tag:'Optional / identity',text:'Give this fictional twin a nickname, if you like.',textInput:true},{id:'futureNote',tag:'Optional / note',text:'What is one thing you want your future self to be better at?',textArea:true}]}
];
const metricNames=['Curiosity','Exploration','Consistency','Focus','Creativity','Adaptability'];
function load(){try{const s=JSON.parse(localStorage.getItem(KEY));if(s)state={...state,...s}}catch(e){}}function persist(){try{localStorage.setItem(KEY,JSON.stringify(state))}catch(e){}}function toast(t){const x=document.getElementById('toast');x.textContent=t;x.classList.add('show');setTimeout(()=>x.classList.remove('show'),2200)}function clamp(n){return Math.max(0,Math.min(100,Math.round(n)))}function val(id,def=2){const a=state.answers[id];return typeof a==='number'?a:(Array.isArray(a)?a.length: a?2:def)}
function calc(){const a=state.answers;const curiosity=clamp((a.curiosity??50)*.55+val('learn')*7+val('risk')*6+val('create')*4);const exploration=clamp(val('free')*13+val('risk')*14+val('breadth')*10+val('learn')*4);const consistency=clamp((a.goalWork??50)*.45+(4-val('sleep'))*3+val('activity')*7+(4-val('screen'))*4+val('approach')*5);const focus=clamp((a.goalWork??50)*.4+(4-val('screen'))*8+val('free')*9+val('approach')*8);const creativity=clamp(val('create')*17+val('learn')*10+val('free')*5+((a.goals||[]).includes('Creativity')?18:0));const adaptability=clamp(val('fail')*12+val('approach')*12+val('risk')*8+val('breadth')*5);return {Curiosity:curiosity,Exploration:exploration,Consistency:consistency,Focus:focus,Creativity:creativity,Adaptability:adaptability}}
function renderQuestion(){const s=steps[state.step];document.getElementById('flowTitle').textContent=s.title;document.getElementById('flowSub').textContent=s.sub;document.getElementById('progressBar').style.width=((state.step+1)/steps.length*100)+'%';document.querySelectorAll('.rail-step').forEach((x,i)=>x.classList.toggle('current',i===state.step));const qv=document.getElementById('questionView');qv.innerHTML='';s.questions.forEach(q=>{const box=document.createElement('div');box.className='question';box.innerHTML='<div class="question-tag">'+q.tag+'</div><h3>'+q.text+'</h3>';if(q.opts){const opts=document.createElement('div');opts.className='options';q.opts.forEach((o,i)=>{const b=document.createElement('button');b.className='option '+(state.answers[q.id]===i?'selected':'');b.innerHTML=o+(q.id==='learn'&&i===4?'<small>Learn by trying it yourself.</small>':'');b.onclick=()=>{state.answers[q.id]=i;renderQuestion();};opts.appendChild(b)});box.appendChild(opts)}if(q.multi){const opts=document.createElement('div');opts.className='check-grid';(state.answers[q.id]||[]).forEach(()=>{});q.multi.forEach(o=>{const b=document.createElement('button');b.className='check '+((state.answers[q.id]||[]).includes(o)?'selected':'');b.textContent=o;b.onclick=()=>{let x=state.answers[q.id]||[];x=x.includes(o)?x.filter(v=>v!==o):x.length<4?[...x,o]:x;state.answers[q.id]=x;renderQuestion()};opts.appendChild(b)});box.appendChild(opts)}if(q.range){const wrap=document.createElement('div');wrap.className='range-wrap';const n=state.answers[q.id]??50;wrap.innerHTML='<div class="range-value">'+n+'%</div><input type="range" min="0" max="100" value="'+n+'" aria-label="'+q.text+'">';wrap.querySelector('input').oninput=e=>{state.answers[q.id]=+e.target.value;renderQuestion()};box.appendChild(wrap)}if(q.textInput){const i=document.createElement('input');i.className='text-input';i.style.minHeight='auto';i.value=state.answers[q.id]||'';i.placeholder='Optional nickname';i.oninput=e=>state.answers[q.id]=e.target.value;box.appendChild(i)}if(q.textArea){const i=document.createElement('textarea');i.className='text-input';i.placeholder='Optional, non-sensitive reflection';i.value=state.answers[q.id]||'';i.oninput=e=>state.answers[q.id]=e.target.value;box.appendChild(i)}qv.appendChild(box)});document.getElementById('backBtn').disabled=state.step===0;document.getElementById('nextBtn').textContent=state.step===steps.length-1?'Initialize twin':'Next signal'}
function show(id){['landing','workspace','build','report'].forEach(x=>document.getElementById(x).classList.remove('active'));document.getElementById(id).classList.add('active');window.scrollTo({top:0,behavior:'smooth'})}
function start(){document.getElementById('privacy').classList.remove('open');state.step=0;state.answers={};show('workspace');renderQuestion()}
function build(){show('build');const stages=['Analyzing choices...','Mapping tendencies...','Building simulation...','Generating possible trajectories...','Twin initialized.'];let i=0;const timer=setInterval(()=>{document.getElementById('buildStage').textContent=stages[i++];if(i===stages.length){clearInterval(timer);state.twin=calc();state.nickname=state.answers.nickname||'Unnamed signal';state.lab={...state.twin};state.achievements=[...new Set([...state.achievements,'first'])];persist();renderReport();show('report')}},520)}
function renderReport(){const m=state.twin||calc();const sorted=Object.entries(m).sort((a,b)=>b[1]-a[1]);const lead=sorted[0][0].toLowerCase();document.getElementById('twinName').textContent='The '+(lead==='creativity'?'Pattern Maker':lead==='exploration'?'Open Horizon':lead==='focus'?'Signal Builder':lead==='consistency'?'Steady Current':'Signal Seeker');document.getElementById('nicknameDisplay').textContent=state.nickname||'Unnamed signal';document.getElementById('twinSummary').textContent='Your Twin currently leans toward '+lead+' through the choices you explored. This is a descriptive simulation tendency, not a diagnosis.';document.getElementById('visualNote').textContent='The core uses visual metaphors: higher creativity adds liveliness, higher consistency stabilizes the rhythm, exploration widens the orbit, and curiosity activates more nodes.';document.getElementById('metrics').innerHTML=metricNames.map(k=>'<div class="metric"><strong>'+m[k]+'%</strong><span>'+k+'</span></div>').join('');document.getElementById('profile').textContent='This simulation suggests a '+(lead==='exploration'?'wide-ranging':'distinctive')+' learning path shaped by '+lead+'. Try changing one signal below to see how a different fictional scenario emerges.';document.getElementById('strengths').textContent=sorted.slice(0,2).map(x=>x[0]).join(' · ')+'. The model sees room to build on these signals through experimentation.';document.getElementById('growth').textContent=sorted.slice(-2).map(x=>x[0]).join(' · ')+'. This is an invitation to test a small routine, not a judgment.';document.getElementById('trajectory').innerHTML='<article><h4>TRAJECTORY A / THE EXPLORER</h4><p>Prioritizes curiosity, experimentation, and new experiences. A fictional path with wider orbit and more open loops.</p></article><article><h4>TRAJECTORY B / THE BUILDER</h4><p>Prioritizes consistency, skill development, and long-term projects. A fictional path with a steadier rhythm.</p></article><article><h4>TRAJECTORY C / THE BALANCED PATH</h4><p>Maintains learning, rest, connection, exploration, and consistency in a deliberately mixed scenario.</p></article>';['focus','explore','consistency','curiosity'].forEach(k=>{const key=k==='explore'?'Exploration':k[0].toUpperCase()+k.slice(1);document.getElementById(k+'Lab').value=m[key];document.getElementById(k+'Out').textContent=m[key]+'%'});renderDNA(m);renderLab();renderChallenges();renderHistory();renderAchievements();loadJournal()}
function renderDNA(m){const svg=document.getElementById('radar');const keys=['Curiosity','Exploration','Consistency','Focus','Creativity','Adaptability'];const cx=200,cy=125,r=92;let grid='',points='';for(let ring=1;ring<=3;ring++){let p=keys.map((_,i)=>{const a=-Math.PI/2+i*Math.PI*2/keys.length;return (cx+Math.cos(a)*r*ring/3)+','+(cy+Math.sin(a)*r*ring/3)}).join(' ');grid+='<polygon points="'+p+'" fill="none" stroke="#273752" stroke-width="1"/>'}keys.forEach((k,i)=>{const a=-Math.PI/2+i*Math.PI*2/keys.length;const x=cx+Math.cos(a)*r,y=cy+Math.sin(a)*r;grid+='<line x1="'+cx+'" y1="'+cy+'" x2="'+x+'" y2="'+y+'" stroke="#273752"/><text x="'+(x+(x<cx?-34:8))+'" y="'+(y+(y<cy?-5:14))+'" fill="#8d9bb2" font-size="10">'+k+'</text>';const rr=r*m[k]/100;points+=(i?' ':'')+(cx+Math.cos(a)*rr)+','+(cy+Math.sin(a)*rr)});svg.innerHTML=grid+'<polygon points="'+points+'" fill="rgba(200,241,105,.13)" stroke="#c8f169" stroke-width="2"/>'}
function renderLab(){const m=state.twin;const x={};['focus','explore','consistency','curiosity'].forEach(k=>{const key=k==='explore'?'Exploration':k[0].toUpperCase()+k.slice(1);x[key]=+document.getElementById(k+'Lab').value;document.getElementById(k+'Out').textContent=x[key]+'%'});document.getElementById('currentCompare').innerHTML=metricNames.map(k=>'<div style="font-size:11px;margin:10px 0">'+k+' <b style="float:right">'+m[k]+'%</b><div class="bar"><i style="width:'+m[k]+'%"></i></div></div>').join('');document.getElementById('experimentalCompare').innerHTML=metricNames.map(k=>{let n=x[k]??m[k];return '<div style="font-size:11px;margin:10px 0">'+k+' <b style="float:right;color:var(--lime)">'+n+'%</b><div class="bar"><i style="width:'+n+'%"></i></div></div>'}).join('')}
function renderChallenges(){const m=state.twin;const cs=[['BALANCE',Math.abs(m.Consistency-m.Exploration)<18,'Bring consistency and exploration within 18 points.'],['EXPLORER',m.Exploration>75&&m.Consistency>45,'Reach 76+ exploration without sacrificing consistency.'],['CREATOR',m.Creativity>75&&m.Curiosity>65,'Build a twin emphasizing creativity and learning.'],['FOCUSED BUILDER',m.Focus>75&&m.Consistency>70,'Create a focused, consistent fictional twin.']];document.getElementById('challengeList').innerHTML=cs.map(c=>'<div class="achievement '+(c[1]?'unlocked':'')+'"><b>'+c[0]+'</b>&nbsp; '+c[2]+'</div>').join('')}
function renderHistory(){const h=state.history||[];document.getElementById('historyList').innerHTML=h.length?h.map((x,i)=>'<div class="history-item"><div><strong>Twin #'+String(i+1).padStart(2,'0')+'</strong><br><small>'+new Date(x.date).toLocaleString()+' · '+Object.entries(x.metrics).slice(0,3).map(e=>e[0]+' '+e[1]+'%').join(' · ')+'</small></div><button class="btn ghost" data-open="'+i+'">Open</button></div>').join(''):'<small style="color:var(--muted)">No saved twins yet. Save a version to create a local history.</small>';document.querySelectorAll('[data-open]').forEach(b=>b.onclick=()=>{state.twin=h[+b.dataset.open].metrics;state.nickname=h[+b.dataset.open].nickname;renderReport();toast('Twin opened locally')})}
function renderAchievements(){const a=[['first','FIRST TWIN','Created your first digital twin.'],['whatif','FUTURE EXPLORER','Ran your first What If simulation.'],['reflect','REFLECTOR','Completed a reflection.'],['experiment','EXPERIMENTER','Changed five variables.'],['architect','TWIN ARCHITECT','Created three saved versions.']];document.getElementById('achievements').innerHTML=a.map(x=>'<span class="achievement '+(state.achievements.includes(x[0])?'unlocked':'')+'"><b>'+x[1]+'</b>&nbsp; '+x[2]+'</span>').join('')}
function loadJournal(){const j=state.journal||{};['j1','j2','j3','j4'].forEach((x,i)=>document.getElementById(x).value=j['j'+(i+1)]||'')}
document.getElementById('startBtn').onclick=()=>document.getElementById('privacy').classList.add('open');document.getElementById('startTop').onclick=()=>document.getElementById('privacy').classList.add('open');document.getElementById('continueBtn').onclick=start;document.getElementById('useBtn').onclick=start;document.getElementById('privacyBtn').onclick=()=>document.getElementById('privacy').classList.add('open');document.getElementById('howBtn').onclick=()=>alert('You answer broad habit and preference questions. A deterministic local model turns those answers into invented metrics and fictional trajectories. Nothing is sent anywhere, and nothing predicts your actual future.');document.getElementById('backBtn').onclick=()=>{if(state.step>0){state.step--;renderQuestion()}};document.getElementById('nextBtn').onclick=()=>{if(state.step<steps.length-1){state.step++;renderQuestion()}else build()};['focus','explore','consistency','curiosity'].forEach(k=>document.getElementById(k+'Lab').oninput=renderLab);document.getElementById('runWhatIf').onclick=()=>{state.achievements=[...new Set([...state.achievements,'whatif'])];persist();renderLab();renderAchievements();toast('Experimental twin recalculated locally')};document.getElementById('saveTwin').onclick=()=>{state.history=[...(state.history||[]),{date:new Date().toISOString(),nickname:state.nickname,metrics:state.twin}];state.achievements=[...new Set([...state.achievements,'architect'])];persist();renderHistory();renderAchievements();toast('Twin saved to this browser')};document.getElementById('saveJournal').onclick=()=>{['j1','j2','j3','j4'].forEach((x,i)=>state.journal['j'+(i+1)]=document.getElementById(x).value);state.achievements=[...new Set([...state.achievements,'reflect'])];persist();renderAchievements();toast('Reflection saved locally')};document.getElementById('eraseAll').onclick=()=>{if(confirm('Erase all saved twins, reflections, and achievements from this browser?')){localStorage.removeItem(KEY);state.history=[];state.journal={};state.achievements=[];renderHistory();renderAchievements();toast('Local data erased')}};document.getElementById('newTwin').onclick=()=>{state.answers={};state.step=0;show('workspace');renderQuestion()};document.getElementById('resetBtn').onclick=()=>{state.answers={};state.twin=null;show('landing');toast('Current twin reset')};document.getElementById('printBtn').onclick=()=>window.print();load();
</script></body></html>
