<title>The 1000-Year City</title>
<style>
:root{--ink:#dce8e5;--muted:#8ba3a0;--bg:#071012;--panel:#0d1b1d;--panel2:#102326;--line:#234044;--cyan:#64d6c7;--amber:#f5bd68;--red:#ef7f73;--green:#85d49b;--shadow:0 24px 60px #0008}*{box-sizing:border-box}html,body{margin:0;background:radial-gradient(circle at 75% 0,#183c3d 0,#071012 43%);color:var(--ink);font:14px/1.45 Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,sans-serif;min-height:100%}button,select{font:inherit}button{cursor:pointer;color:inherit}.app{min-height:100vh}.topbar{height:68px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 28px;background:#071012d9;backdrop-filter:blur(16px);position:sticky;top:0;z-index:5}.brand{display:flex;gap:13px;align-items:center;font-weight:700;letter-spacing:.18em;font-size:12px}.mark{width:28px;height:28px;border:1px solid var(--cyan);position:relative;transform:rotate(45deg)}.mark:after,.mark:before{content:"";position:absolute;background:var(--cyan)}.mark:before{width:1px;height:36px;left:13px;top:-5px}.mark:after{height:1px;width:36px;left:-5px;top:13px}.top-actions{display:flex;gap:8px;align-items:center}.tiny{font-size:11px;color:var(--muted);letter-spacing:.08em;text-transform:uppercase}.btn{border:1px solid var(--line);background:#102326;padding:10px 14px;border-radius:3px;transition:.18s ease;letter-spacing:.06em;text-transform:uppercase;font-size:11px;font-weight:700}.btn:hover{border-color:var(--cyan);background:#173437;transform:translateY(-1px)}.btn:active{transform:scale(.97)}.btn.primary{background:var(--cyan);color:#06201f;border-color:var(--cyan)}.btn.primary:hover{background:#8ce7dc}.btn.ghost{background:transparent}.layout{display:grid;grid-template-columns:230px minmax(0,1fr) 290px;min-height:calc(100vh - 68px)}aside{padding:24px 16px;border-right:1px solid var(--line);background:#09151688}.right{border-left:1px solid var(--line);border-right:0}.side-head{padding:0 10px 18px;border-bottom:1px solid var(--line);margin-bottom:16px}.side-head strong{display:block;font-size:11px;letter-spacing:.2em;color:var(--cyan)}nav{display:grid;gap:4px}.nav{display:flex;gap:10px;align-items:center;border:1px solid transparent;background:transparent;padding:11px 10px;text-align:left;color:var(--muted);border-radius:3px}.nav:hover,.nav.active{color:var(--ink);background:#13292a;border-color:#244b4d}.nav.active{box-shadow:inset 3px 0 var(--cyan)}.nav b{font-size:12px;width:18px;color:var(--cyan)}.content{padding:28px;max-width:1500px;width:100%;margin:auto}.hero{display:flex;justify-content:space-between;gap:20px;align-items:flex-end;margin-bottom:24px}.eyebrow{color:var(--cyan);font-size:11px;letter-spacing:.2em;text-transform:uppercase}.hero h1{font:500 clamp(28px,4vw,55px)/1.03 Georgia,serif;letter-spacing:-.03em;margin:7px 0}.hero p{color:var(--muted);max-width:560px;margin:10px 0 0}.year-badge{text-align:right}.year-badge .num{display:block;font:500 46px/1 Georgia;color:var(--amber)}.grid{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(280px,.75fr);gap:16px}.panel{background:linear-gradient(145deg,#0e2022ee,#0a1618ee);border:1px solid var(--line);box-shadow:var(--shadow);border-radius:4px}.panel-head{display:flex;justify-content:space-between;gap:12px;align-items:center;border-bottom:1px solid var(--line);padding:15px 17px}.panel-head h2{margin:0;font-size:12px;letter-spacing:.16em;text-transform:uppercase}.panel-body{padding:17px}.map-wrap{position:relative;min-height:470px;overflow:hidden;background:#092126}.map-wrap canvas{width:100%;height:470px;display:block}.map-key{position:absolute;left:15px;bottom:14px;display:flex;flex-wrap:wrap;gap:8px;background:#071012d9;padding:8px;border:1px solid var(--line);font-size:10px;color:var(--muted)}.key{display:flex;gap:5px;align-items:center}.dot{width:8px;height:8px;border-radius:50%}.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:9px}.metric{padding:12px 11px;background:#0a181a;border:1px solid #1a3639}.metric small{color:var(--muted);text-transform:uppercase;letter-spacing:.09em;font-size:9px}.metric strong{display:block;font:24px Georgia;margin-top:4px;color:var(--cyan)}.metric em{font-style:normal;font-size:10px;color:var(--muted)}.bars{display:grid;gap:12px}.bar-row{display:grid;grid-template-columns:112px 1fr 34px;align-items:center;gap:9px;font-size:11px}.track{height:6px;background:#182c2e;border-radius:3px;overflow:hidden}.fill{height:100%;background:var(--cyan);transition:width .5s}.fill.warn{background:var(--amber)}.fill.bad{background:var(--red)}.timeline{display:flex;align-items:center;gap:0;overflow:auto;padding:18px 0 6px}.time-node{min-width:74px;text-align:center;color:var(--muted);font-size:10px}.time-node button{border:1px solid var(--line);background:#102326;width:32px;height:32px;border-radius:50%;color:var(--muted);margin-bottom:8px}.time-node.active button{background:var(--cyan);color:#061817;border-color:var(--cyan)}.time-node.active{color:var(--cyan)}.time-line{height:1px;background:var(--line);width:32px}.choices{display:grid;gap:8px}.choice{border:1px solid var(--line);background:#0b1a1c;padding:13px;text-align:left;border-radius:3px}.choice:hover,.choice.selected{border-color:var(--cyan);background:#123033}.choice strong{display:block;color:var(--ink);font-size:12px;letter-spacing:.08em}.choice span{display:block;color:var(--muted);font-size:11px;margin-top:4px}.choice .trade{color:var(--amber);font-size:10px;margin-top:8px}.tabs{display:flex;gap:5px;overflow:auto;margin-bottom:14px}.tab{background:transparent;border:1px solid var(--line);padding:8px 12px;color:var(--muted);font-size:10px;letter-spacing:.12em;text-transform:uppercase}.tab.active{background:#183537;color:var(--cyan);border-color:var(--cyan)}.view{display:none}.view.active{display:block}.stack{display:grid;gap:16px}.insight{border-left:2px solid var(--amber);padding:11px 13px;background:#171c16;color:#cbd8c9;font-size:12px}.insight strong{display:block;color:var(--amber);font-size:10px;letter-spacing:.16em;margin-bottom:4px}.tech-tree{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;align-items:start}.tech-col h3{font-size:10px;letter-spacing:.12em;color:var(--cyan);margin:0 0 10px}.tech{border:1px solid var(--line);padding:9px 8px;margin-bottom:8px;color:var(--muted);font-size:11px;background:#0a181a}.tech.unlocked{color:var(--ink);border-color:#3b827c;background:#113234}.tech.unlocked:before{content:"✓ ";color:var(--green)}.event{display:grid;grid-template-columns:62px 1fr;gap:12px;border-bottom:1px solid var(--line);padding:12px 0}.event:last-child{border:0}.event-year{font:18px Georgia;color:var(--amber)}.event h3{margin:0;font-size:12px}.event p{margin:4px 0;color:var(--muted);font-size:11px}.score-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.score{padding:12px;border:1px solid var(--line);background:#0a181a}.score-head{display:flex;justify-content:space-between;font-size:11px}.score strong{color:var(--cyan)}.modal{position:fixed;inset:0;background:#020809d9;backdrop-filter:blur(8px);display:none;align-items:center;justify-content:center;padding:20px;z-index:10}.modal.open{display:flex}.modal-card{max-width:700px;width:100%;max-height:90vh;overflow:auto;background:#0b1a1c;border:1px solid var(--cyan);box-shadow:0 0 0 8px #64d6c711,0 30px 80px #000d;padding:28px}.modal-card h2{font:36px Georgia;margin:0 0 10px;color:var(--amber)}.modal-card p{color:var(--muted)}.modal-actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:20px}.select{background:#0b1a1c;color:var(--ink);border:1px solid var(--line);padding:9px}.compare{display:grid;grid-template-columns:1fr 1fr;gap:12px}.compare-card{padding:15px;border:1px solid var(--line);background:#0a181a}.compare-card h3{margin:0 0 12px;color:var(--cyan);font-size:12px;letter-spacing:.12em}.notice{color:var(--muted);font-size:11px}.mobile-only{display:none}@media(max-width:1100px){.layout{grid-template-columns:76px minmax(0,1fr)}.right{display:none}.side-head span,nav .nav span{display:none}.side-head{text-align:center}.nav{justify-content:center}.content{padding:22px}.grid{grid-template-columns:1fr}.metrics{grid-template-columns:repeat(4,1fr)}}@media(max-width:650px){.topbar{padding:0 14px}.top-actions .tiny{display:none}.layout{display:block}.layout>aside{display:none}.content{padding:15px}.hero{align-items:flex-start}.year-badge .num{font-size:34px}.grid{display:block}.grid>.stack{margin-top:16px}.metrics{grid-template-columns:repeat(2,1fr)}.map-wrap,.map-wrap canvas{min-height:330px;height:330px}.bar-row{grid-template-columns:94px 1fr 30px}.tech-tree{grid-template-columns:repeat(2,1fr)}.mobile-only{display:flex;gap:6px;margin-bottom:12px}.tabs{padding-bottom:3px}.modal-card h2{font-size:28px}}
</style>
</head>
<body>
<div class="app">
<header class="topbar"><div class="brand"><span class="mark"></span><span>THE 1000-YEAR CITY</span></div><div class="top-actions"><span class="tiny" id="saveState">Local archive ready</span><button class="btn ghost" id="saveBtn">Save city</button><button class="btn ghost" id="newBtn">New city</button></div></header>
<div class="layout"><aside><div class="side-head"><strong>CIVILIZATION<br>CONTROL</strong><span class="tiny">Founder console</span></div><nav id="nav"><button class="nav active" data-view="overview"><b>01</b><span>Overview</span></button><button class="nav" data-view="systems"><b>02</b><span>Systems lab</span></button><button class="nav" data-view="tech"><b>03</b><span>Technology</span></button><button class="nav" data-view="history"><b>04</b><span>City archives</span></button><button class="nav" data-view="compare"><b>05</b><span>Compare</span></button></nav><div style="margin-top:28px;padding:10px"><div class="tiny">Simulation note</div><p class="notice">A simplified educational model for systems thinking—not a real-world forecast.</p></div></aside>
<main class="content"><div class="mobile-only"><button class="tab active" data-view="overview">Overview</button><button class="tab" data-view="systems">Systems</button><button class="tab" data-view="tech">Tech</button><button class="tab" data-view="history">Archives</button><button class="tab" data-view="compare">Compare</button></div>
<section class="view active" id="overview"><div class="hero"><div><div class="eyebrow">Founder console / long-term planning instrument</div><h1>Build today.<br><i>Shape tomorrow.</i></h1><p>You have been given control of a newly founded settlement. Every choice is a signal sent forward through generations.</p></div><div class="year-badge"><span class="tiny">Current horizon</span><span class="num" id="yearLabel">YEAR 0</span><span class="tiny" id="eraLabel">FOUNDATION</span></div></div><div class="grid"><div class="panel"><div class="panel-head"><h2>Living city map</h2><span class="tiny" id="mapHint">Select a district</span></div><div class="map-wrap"><canvas id="cityCanvas" aria-label="Procedurally drawn city map"></canvas><div class="map-key"><span class="key"><i class="dot" style="background:#69c9b5"></i>water</span><span class="key"><i class="dot" style="background:#709b62"></i>ecology</span><span class="key"><i class="dot" style="background:#d0a36b"></i>food</span><span class="key"><i class="dot" style="background:#cf7f72"></i>housing</span><span class="key"><i class="dot" style="background:#b8b7a0"></i>civic</span></div></div><div class="panel-body"><div class="metrics"><div class="metric"><small>Population</small><strong id="mPop">500</strong><em>people</em></div><div class="metric"><small>Ecology</small><strong id="mEco">100</strong><em>/ 100</em></div><div class="metric"><small>Knowledge</small><strong id="mKnow">10</strong><em>/ 100</em></div><div class="metric"><small>Resilience</small><strong id="mRes">42</strong><em>/ 100</em></div></div></div></div><div class="stack"><div class="panel"><div class="panel-head"><h2>City profile</h2><span class="tiny" id="identity">Balanced</span></div><div class="panel-body"><div class="bars" id="scoreBars"></div></div></div><div class="panel"><div class="panel-head"><h2>Next decision</h2><span class="tiny">Planning phase</span></div><div class="panel-body"><p class="notice" id="decisionPrompt">Choose a growth direction before the first decade.</p><div class="choices" id="choices"></div><button class="btn primary" style="width:100%;margin-top:12px" id="advanceBtn">Advance time →</button></div></div></div></div><div class="panel" style="margin-top:16px"><div class="panel-head"><h2>Temporal instrument</h2><span class="tiny">Jump to a remembered year</span></div><div class="panel-body"><div class="timeline" id="timeline"></div></div></div></section>
<section class="view" id="systems"><div class="hero"><div><div class="eyebrow">Systems laboratory</div><h1>Decisions leave<br><i>signatures.</i></h1><p>Each policy changes several systems at once. There is no universally perfect path—only choices with different horizons.</p></div></div><div class="grid"><div class="stack"><div class="panel"><div class="panel-head"><h2>Policy instruments</h2><span class="tiny">Current era</span></div><div class="panel-body" id="policyLab"></div></div><div class="panel"><div class="panel-head"><h2>Why this matters</h2></div><div class="panel-body"><div class="insight"><strong>Systems thinking</strong><span id="whyText">A dense city can use less land per person, but it asks more from water, transit and public infrastructure.</span></div></div></div></div><div class="stack"><div class="panel"><div class="panel-head"><h2>Resource balance</h2></div><div class="panel-body"><div class="bars" id="resourceBars"></div></div></div><div class="panel"><div class="panel-head"><h2>Land use</h2><span class="tiny">Dynamic allocation</span></div><div class="panel-body"><div class="bars" id="landBars"></div></div></div></div></div></section>
<section class="view" id="tech"><div class="hero"><div><div class="eyebrow">Civilization technology tree</div><h1>Knowledge compounds<br><i>across centuries.</i></h1><p>Investment in learning opens options later. Technology is represented as a tendency, not a prophecy.</p></div></div><div class="panel"><div class="panel-head"><h2>Unlock pathways</h2><span class="tiny" id="techSummary">0 nodes unlocked</span></div><div class="panel-body"><div class="tech-tree" id="techTree"></div></div></div><div class="panel" style="margin-top:16px"><div class="panel-head"><h2>Cascade effect</h2><select class="select" id="cascadeSelect" aria-label="Choose an archived decision"></select></div><div class="panel-body" id="cascade"></div></div></section>
<section class="view" id="history"><div class="hero"><div><div class="eyebrow">City archives / museum mode</div><h1>A civilization is<br><i>what it remembers.</i></h1><p>Events are generated from the state of the city, so the archive is a record of consequences—not a decorative timeline.</p></div></div><div class="panel"><div class="panel-head"><h2>Chronological history</h2><span class="tiny" id="archiveCount">1 recorded event</span></div><div class="panel-body" id="events"></div></div><div class="panel" style="margin-top:16px"><div class="panel-head"><h2>Achievements</h2></div><div class="panel-body" id="achievements"></div></div></section>
<section class="view" id="compare"><div class="hero"><div><div class="eyebrow">Parallel universe / comparative civics</div><h1>Two cities.<br><i>Different legacies.</i></h1><p>Run an alternate policy from your recorded decisions and examine the trade-offs instead of searching for a single winner.</p></div><button class="btn primary" id="whatIfBtn">Run what-if</button></div><div class="compare"><div class="compare-card"><h3>ORIGINAL TIMELINE</h3><div id="originalCompare"></div></div><div class="compare-card"><h3>ALTERNATIVE TIMELINE</h3><div id="altCompare"><p class="notice">Run a what-if simulation to create a parallel city.</p></div></div></div><div class="panel" style="margin-top:16px"><div class="panel-head"><h2>Trade-off reading</h2></div><div class="panel-body"><div class="insight"><strong>Interpretation</strong><span id="compareText">A comparison becomes available after you reach a later horizon and test an alternative policy.</span></div></div></div></section>
</main><aside class="right"><div class="side-head"><strong>LIVE SIGNALS</strong><span class="tiny">Updated from simulation state</span></div><div class="panel" style="box-shadow:none;margin-bottom:14px"><div class="panel-head"><h2>Latest event</h2></div><div class="panel-body" id="latestEvent"><p class="notice">Settlement founded. The first signal is yours.</p></div></div><div class="panel" style="box-shadow:none"><div class="panel-head"><h2>City profile</h2></div><div class="panel-body"><div class="score-grid" id="sideScores"></div></div></div><div style="padding:18px 10px"><div class="tiny">Controls</div><p class="notice">Press <b>Space</b> to advance time. Press <b>1–5</b> to select a policy option.</p></div></aside></div></div>
<div class="modal" id="modal"><div class="modal-card"><div class="eyebrow">Temporal transition</div><h2 id="modalTitle">50 YEARS PASS</h2><p id="modalText"></p><div class="metrics" id="modalMetrics"></div><div class="modal-actions"><button class="btn primary" id="closeModal">Continue into the future</button></div></div></div>
<script>
'use strict';
const YEARS=[0,10,50,100,250,500,750,1000];
const POLICIES={growth:[['River corridor','easy water access and fertile ground','flood exposure + ecosystem pressure','Near river'],['Hillward expansion','lower flood risk and defensible terrain','construction and mobility cost','Toward hills'],['Distributed plain','easy expansion and flexible land','large infrastructure footprint','Across the plain']],energy:[['Solar constellation','clean modular generation','storage and land requirement','Solar'],['Wind commons','strong seasonal output','grid and siting complexity','Wind'],['River hydro','stable high output','waterway disruption','Hydro'],['Fossil reserve','rapid industrial power','high ecological cost','Fossil'],['Mixed grid','balanced reliability','less specialization','Mixed grid']],water:[['River extraction','low early cost','drought and watershed stress','River'],['Reservoir network','seasonal resilience','land and capital cost','Reservoirs'],['Groundwater','quiet dependable supply','aquifer depletion','Groundwater'],['Reclamation loop','high circularity','technical dependence','Recycling'],['Rainwater mesh','distributed resilience','variable yield','Rainwater'],['Mixed watershed','portfolio flexibility','coordination overhead','Mixed']],food:[['Local agriculture','food culture and fertile land','land pressure','Local agriculture'],['Scale agriculture','high output','monoculture and runoff','Large agriculture'],['Hydroponic districts','low land pressure','energy and technical skill','Hydroponics'],['Imports','preserves local land','trade exposure','Imports'],['Mixed food web','diversified security','coordination cost','Mixed food']],transport:[['Car-dependent','fast initial coverage','land, pollution, congestion','Cars'],['Public transit','access and compact growth','upfront network cost','Transit'],['Walkable city','health and low land use','slower regional reach','Walkable'],['High-speed rail','regional integration','very high capital cost','Rail'],['Mixed transport','balanced access','maintenance complexity','Mixed']],education:[['Basic education','broad literacy','slower frontier research','Basic'],['Higher education','deep civic capacity','long payback','Higher'],['Research institutes','innovation and technology','resource-intensive','Research'],['Technical training','maintainable infrastructure','narrower knowledge base','Technical'],['Libraries + innovation','distributed culture','diffuse returns','Libraries']],housing:[['Low-density housing','quick early shelter','land and service cost','Low density'],['High-density housing','land efficiency','infrastructure and equity demands','High density'],['Mixed-use districts','vibrant compact life','planning complexity','Mixed use'],['Public housing','stability and inclusion','large civic commitment','Public housing'],['Planned communities','coherent expansion','less spontaneous growth','Planned']],prepared:[['Flood defenses','reduces water disaster loss','capital and river modification','Flood defenses'],['Fire prevention','reduces urban fire loss','ongoing civic investment','Fire prevention'],['Emergency services','rapid recovery','operating cost','Emergency services'],['Backup energy','continuity during shocks','capacity may sit idle','Backup energy'],['Water reserves','drought buffer','space and maintenance','Water reserves'],['Evacuation infrastructure','protects lives','land and planning cost','Evacuation']]};
let state={name:'Aster Delta',year:0,pop:500,water:100,energy:100,food:100,land:100,econ:50,eco:100,infra:10,know:10,housing:58,res:42,trade:35,air:95,forest:92,biodiversity:88,landPressure:8,decisions:{},history:[{year:0,title:'Settlement founded',desc:'A small settlement begins at the edge of a watershed.',cause:'The city is given a first horizon.',effect:'Every future system is still open.'}],snapshots:{},achievements:[],alt:null};
let selected={};
const $=id=>document.getElementById(id); const clamp=(n,a=0,b=100)=>Math.max(a,Math.min(b,n)); const fmt=n=>n>=1000000?(n/1000000).toFixed(2)+'M':n>=1000?Math.round(n).toLocaleString():Math.round(n).toString();
function esc(s){return String(s).replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]))}
function save(){localStorage.setItem('1000city:'+state.name,JSON.stringify(state));localStorage.setItem('1000city:last',state.name);$('saveState').textContent='Saved locally · '+new Date().toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'});}
function load(){let n=localStorage.getItem('1000city:last'),raw=n&&localStorage.getItem('1000city:'+n);if(raw)try{state=JSON.parse(raw)}catch(e){} }
function reset(){state={name:'Aster Delta',year:0,pop:500,water:100,energy:100,food:100,land:100,econ:50,eco:100,infra:10,know:10,housing:58,res:42,trade:35,air:95,forest:92,biodiversity:88,landPressure:8,decisions:{},history:[{year:0,title:'Settlement founded',desc:'A small settlement begins at the edge of a watershed.',cause:'The city is given a first horizon.',effect:'Every future system is still open.'}],snapshots:{},achievements:[],alt:null};selected={};save();render();}
function currentIndex(){return YEARS.indexOf(state.year)}
function identity(){let d=state.decisions, tags=[];if(state.know>65)tags.push('Knowledge-driven');if(state.eco>75)tags.push('Ecological');if(state.trade>65)tags.push('Trade-focused');if((d.energy||'').includes('Fossil'))tags.push('Industrial');if(state.infra>65)tags.push('Technological');return tags.length?tags.slice(0,2).join(' · '):'Balanced';}
function calcScores(){return {Livability:clamp((state.water+state.food+state.housing+state.air)/4),Resilience:state.res,Ecology:state.eco,Knowledge:state.know,Infrastructure:state.infra,'Resource security':clamp((state.water+state.food+state.energy)/3),Adaptability:clamp((state.know+state.res+state.econ)/3),'Long-term stability':clamp((state.eco+state.res+state.know+state.infra)/4)}}
function renderBars(obj,target){$(target).innerHTML=Object.entries(obj).map(([k,v])=>`<div class="bar-row"><span>${esc(k)}</span><div class="track"><div class="fill ${v<35?'bad':v<60?'warn':''}" style="width:${clamp(v)}%"></div></div><b>${Math.round(v)}</b></div>`).join('')}
function renderCanvas(){let c=$('cityCanvas'),r=c.getBoundingClientRect(),d=devicePixelRatio||1;c.width=r.width*d;c.height=r.height*d;let x=c.getContext('2d');x.scale(d,d);let w=r.width,h=r.height,scale=.42+state.year/1000*.62,water='#245a60';x.fillStyle='#0b2428';x.fillRect(0,0,w,h);x.fillStyle=water;x.beginPath();x.moveTo(0,h*.16);x.bezierCurveTo(w*.28,h*.28,w*.35,h*.05,w*.6,h*.25);x.bezierCurveTo(w*.77,h*.4,w*.83,h*.18,w,h*.3);x.lineTo(w,0);x.lineTo(0,0);x.fill();x.strokeStyle='#2d7774';x.lineWidth=2;x.stroke();let forest=clamp(state.forest), count=Math.floor(12+state.pop/65);for(let i=0;i<count;i++){let px=(i*83%w),py=80+(i*47%(h-100));if(py<h*.4&&px>w*.55)continue;x.fillStyle=forest>55?'#315d47':'#293f3d';x.beginPath();x.arc(px,py,3+((i*7)%5),0,7);x.fill()}let n=Math.max(3,Math.floor(3+state.pop/450));for(let i=0;i<n;i++){let px=w*.35+(i*67%Math.max(40,w*.55)),py=h*.43+(i*31%Math.max(30,h*.39));let ww=(20+(state.infra*.28))*scale,hh=(15+(state.infra*.2))*scale;x.fillStyle=i%4===0?'#b8b7a0':i%3===0?'#cf7f72':'#ad8770';x.fillRect(px,py,ww,hh);x.fillStyle='#f0c678';x.fillRect(px+4,py+4,3,3);x.fillRect(px+ww-7,py+4,3,3)}x.strokeStyle='#847d6d99';x.lineWidth=3;for(let i=0;i<Math.min(7,2+state.infra/18);i++){x.beginPath();x.moveTo(w*.28,h*(.86-i*.07));x.lineTo(w*.82,h*(.64-i*.07));x.stroke()}x.fillStyle='#d0a36b';x.fillRect(w*.12,h*.65,Math.min(w*.22,60+state.pop/18),h*.13);x.fillStyle='#c7b68b';x.fillRect(w*.45,h*.48,55,34);x.fillStyle='#b8b7a0';x.fillRect(w*.48,h*.44,20,6);x.fillStyle='#64d6c7';x.beginPath();x.arc(w*.15,h*.25,12,0,7);x.fill();x.fillStyle='#071012';x.font='10px system-ui';x.fillText('RIVER',w*.04,h*.12);x.fillText('CIVIC CORE',w*.43,h*.46);x.fillText('AGRICULTURE',w*.11,h*.82);$('mapHint').textContent=`${n} active districts · ecological health ${Math.round(state.eco)}`}
function renderTimeline(){let i=currentIndex();$('timeline').innerHTML=YEARS.map((y,j)=>`${j?'<div class="time-line"></div>':''}<div class="time-node ${j===i?'active':''}"><button onclick="jumpYear(${y})" aria-label="View year ${y}">${y}</button><div>${y===0?'FOUNDATION':y===1000?'REVEAL':y<100?'FORMATION':'EXPANSION'}</div></div>`).join('')}
function renderChoices(){let idx=currentIndex(), key=idx===0?'growth':idx===1?'energy':idx===2?'water':idx===3?'food':idx===4?'transport':idx===5?'education':'prepared';let opts=POLICIES[key]||POLICIES.prepared;let prompt={growth:'Choose a growth direction before the first decade.',energy:'Your first urban system: how will the city power its expansion?',water:'A larger population needs a watershed strategy.',food:'A city is only as resilient as its food web.',transport:'Mobility choices become land-use choices.',education:'What knowledge will your descendants inherit?',prepared:'The next century tests the city’s ability to recover.'}[key];$('decisionPrompt').textContent=prompt;$('choices').innerHTML=opts.map((o,n)=>`<button class="choice ${selected[key]===n?'selected':''}" onclick="choose('${key}',${n})"><strong>${n+1}. ${esc(o[0])}</strong><span>${esc(o[1])}</span><div class="trade">Trade-off · ${esc(o[2])}</div></button>`).join('')}
function choose(key,n){selected[key]=n;renderChoices();let o=POLICIES[key][n];$('whyText').textContent=why(key,n);$('policyLab').innerHTML=policyHTML(key);}
function why(k,n){let t={growth:['River access accelerates early settlement, but it makes every floodplain decision a future liability.','Moving uphill buys safety from water, yet every road and pipe must climb with the city.','A distributed city can expand flexibly, but distance becomes an infrastructure obligation.'],energy:['Solar reduces pollution, but storage and land become part of the energy problem.','Wind diversifies the grid, while transmission and seasonal variation matter.','Hydro supplies stable energy, but a river is also an ecosystem.','Fossil energy accelerates industry while borrowing ecological capacity from the future.','A mixed grid gives up specialization for flexibility and redundancy.']}[k];return t?.[n]||'This choice shifts resources, risk and opportunity across several systems at once.'}
function policyHTML(k){let groups=[['Energy strategy','energy'],['Water strategy','water'],['Food strategy','food'],['Mobility strategy','transport'],['Learning strategy','education'],['Housing strategy','housing'],['Preparedness investment','prepared']];return groups.map(([label,key])=>`<div style="margin-bottom:18px"><div class="tiny" style="margin-bottom:7px">${label}</div><div class="choices">${POLICIES[key].map((o,n)=>`<button class="choice ${state.decisions[key]===n?'selected':''}" onclick="chooseLive('${key}',${n})"><strong>${n+1}. ${esc(o[0])}</strong><span>${esc(o[1])}</span><div class="trade">Trade-off · ${esc(o[2])}</div></button>`).join('')}</div></div>`).join('')}
function chooseLive(k,n){state.decisions[k]=n;selected[k]=n;choose(k,n);save();render();}
function applyDecision(key,n){let d=state.decisions;d[key]=n;if(key==='growth'){state.infra+=n===2?3:1;state.eco+=n===0?-5:n===1?2:-2;state.landPressure+=n===2?10:n===0?6:2;state.res+=n===1?5:0}if(key==='energy'){state.energy+=n===3?25:n===2?18:10;state.eco+=n===3?-16:n===2?-5:n===0?5:2;state.infra+=n===1?5:n===2?8:2}if(key==='water'){state.water+=n===0?15:n===1?22:n===2?12:n===3?28:n===4?10:20;state.eco+=n===0?-6:n===3?4:2;state.res+=n===1||n===3?7:2}if(key==='food'){state.food+=n===1?22:n===2?17:n===3?7:14;state.landPressure+=n===1?12:n===2?-8:n===3?-10:3;state.eco+=n===1?-7:n===2?3:0}if(key==='transport'){state.infra+=n===3?13:n===0?7:4;state.eco+=n===0?-10:n===2?5:n===1?3:1;state.landPressure+=n===0?10:n===2?-5:2;state.trade+=n===3?8:2}if(key==='education'){state.know+=n===2?18:n===1?13:n===3?11:n===4?9:6;state.econ+=n===2?4:2;state.res+=n===1||n===2?5:2}if(key==='housing'){state.housing+=n===1?20:n===3?14:10;state.infra+=n===1?5:2;state.landPressure+=n===0?10:n===1?-5:2}if(key==='prepared'){state.res+=n===0&&state.decisions.growth===0?12:n===3?9:n===4?7:5;state.infra+=2}Object.keys(state).forEach(k=>{if(typeof state[k]==='number'&&['pop'].indexOf(k)<0)state[k]=clamp(state[k])})}
function advance(){let i=currentIndex();if(i>=YEARS.length-1){showReveal();return}let key=i===0?'growth':i===1?'energy':i===2?'water':i===3?'food':i===4?'transport':i===5?'education':'prepared';let choice=selected[key]??state.decisions[key]??0;applyDecision(key,choice);let old=state.year;state.year=YEARS[i+1];let years=state.year-old;let quality=(state.water+state.food+state.housing+state.econ+state.eco)/5;let growth=(.008+quality/10000+state.know/18000-state.landPressure/18000)*years;state.pop=Math.max(120,Math.round(state.pop*(1+growth)));state.water=clamp(state.water-years*.05+state.infra*.015);state.food=clamp(state.food-years*.035+state.eco*.01);state.energy=clamp(state.energy-years*.04+state.infra*.018);state.econ=clamp(state.econ+state.know*.02+state.trade*.01-state.landPressure*.015);state.eco=clamp(state.eco-years*.018+state.know*.008-state.landPressure*.025);state.air=clamp(state.eco+10-state.pop/18000);state.forest=clamp(state.eco-4);state.biodiversity=clamp(state.eco-8);state.housing=clamp(state.housing+state.infra*.01-state.pop/90000);state.res=clamp(state.res+state.infra*.015+state.know*.01);state.landPressure=clamp(state.landPressure+state.pop/50000-state.eco*.005);state.snapshots[state.year]=JSON.parse(JSON.stringify(state));makeEvent();achievements();save();render();showTransition(years)}
function makeEvent(){let title,desc,cause,effect;if(state.water<35){title='WATER STRESS';desc='The watershed is under pressure as demand outpaces renewal.';cause='Water capacity did not scale with population.';effect='Future decisions must prioritize circularity and reserves.'}else if(state.eco<42){title='ECOLOGICAL CROSSING';desc='Air, water and habitat indicators enter a warning band.';cause='Land pressure and resource extraction accumulated.';effect='The city must repair ecological capacity.'}else if(state.know>70){title='TECHNOLOGICAL BREAKTHROUGH';desc='A research culture creates a new generation of civic tools.';cause='Long-term investment in learning compounded.';effect='Adaptability and infrastructure gain momentum.'}else if(state.res<35){title='SYSTEM FRAGILITY';desc='A shock reveals gaps between the city’s networks.';cause='Growth outpaced preparedness.';effect='Resilience becomes a public priority.'}else{title=state.year>700?'NEW ENERGY TECHNOLOGY':'DISTRICT EXPANSION';desc=state.year>700?'A new civic technology reshapes the urban metabolism.':'New neighborhoods connect to the growing civic core.';cause='Population, policy and infrastructure interacted over time.';effect='The city’s identity continues to evolve.'}state.history.push({year:state.year,title,desc,cause,effect})}
function achievements(){let a=state.achievements;let add=(k,n,c)=>{if(!a.includes(k)&&c)a.push(k)};add('FIRST CITY','First city',true);add('CENTURY BUILDER','Century builder',state.year>=100);add('HALF-MILLENNIUM','Half-millennium',state.year>=500);add('MILLENNIUM','Millennium',state.year>=1000);add('GREEN CITY','Green city',state.eco>=80);add('RESILIENT CITY','Resilient city',state.res>=75);add('KNOWLEDGE CIVILIZATION','Knowledge civilization',state.know>=75);add('BALANCED CIVILIZATION','Balanced civilization',Object.values(calcScores()).every(v=>v>55));if(state.alt)add('ALTERNATE HISTORY','Alternate history',true)}
function showTransition(years){$('modalTitle').textContent=`${years} YEARS PASS`;$('modalText').textContent='Buildings rise. Roads extend. Trees recover—or retreat. The city has moved forward because of the choices you made, not in spite of them.';$('modalMetrics').innerHTML=[['Population',fmt(state.pop)],['Ecology',Math.round(state.eco)],['Knowledge',Math.round(state.know)],['Infrastructure',Math.round(state.infra)]].map(x=>`<div class="metric"><small>${x[0]}</small><strong>${x[1]}</strong><em>updated</em></div>`).join('');$('modal').classList.add('open')}
function showReveal(){$('modalTitle').textContent='1,000 YEARS LATER…';$('modalText').textContent='The simulation pauses here. This is the city you built: a living archive of resources, knowledge, risk and adaptation.';$('modalMetrics').innerHTML=[['Population',fmt(state.pop)],['Ecology',Math.round(state.eco)],['Resilience',Math.round(state.res)],['Identity',identity()]].map(x=>`<div class="metric"><small>${x[0]}</small><strong style="font-size:${x[0]==='Identity'?'15px':'24px'}">${x[1]}</strong><em>final profile</em></div>`).join('');$('modal').classList.add('open')}
function jumpYear(y){if(state.snapshots[y]){state=Object.assign(state,state.snapshots[y]);render();}else if(y===0){state.year=0;render()}}
function renderTech(){let cols=[['ENERGY',['Solar','Storage','Smart grid','Advanced systems']],['TRANSPORT',['Roads','Rail','Electric transit','Advanced transit']],['WATER',['Reservoir','Recycling','Desalination','Closed loop']],['FOOD',['Agriculture','Greenhouses','Hydroponics','Advanced food']],['KNOWLEDGE',['Schools','Universities','Research','Advanced research']]];let levels=Math.floor(state.know/24)+Math.floor(state.infra/30);$('techTree').innerHTML=cols.map((c,ci)=>`<div class="tech-col"><h3>${c[0]}</h3>${c[1].map((x,i)=>`<div class="tech ${(i<Math.min(4,Math.floor(levels/2)+1)&&state.year>=i*50)?'unlocked':''}">${x}</div>`).join('')}</div>`).join('');$('techSummary').textContent=`${Math.min(20,cols.length*(Math.floor(levels/2)+1))} nodes available`;$('cascadeSelect').innerHTML=state.history.map((h,i)=>`<option value="${i}">YEAR ${h.year} — ${h.title}</option>`).join('');renderCascade()}
function renderCascade(){let h=state.history[$('cascadeSelect').value||0]||state.history[0];$('cascade').innerHTML=`<div class="insight"><strong>YEAR ${h.year} · ${esc(h.title)}</strong>${esc(h.desc)}</div><div style="display:grid;grid-template-columns:repeat(5,1fr);gap:5px;margin-top:18px;text-align:center;font-size:10px;color:var(--muted)">${['Decision','Population growth','Urban expansion','Exposure / pressure','Year 1000 outcome'].map((x,i)=>`<div style="padding:14px 6px;border:1px solid ${i===4?'#64d6c7':'#234044'};background:#102326">${x}<br><b style="display:block;color:${i===4?'var(--amber)':'var(--cyan)'};font-size:18px;margin-top:6px">${i===0?'↓':i===1?'→':i===2?'↗':i===3?'⚠':'∞'}</b></div>`).join('')}</div>`}
function render(){let scores=calcScores();$('yearLabel').textContent='YEAR '+state.year;$('eraLabel').textContent=state.year===0?'FOUNDATION':state.year===1000?'MILLENNIUM REVEAL':state.year<100?'FORMATION':state.year<500?'URBAN EXPANSION':'ADVANCED CIVILIZATION';$('mPop').textContent=fmt(state.pop);$('mEco').textContent=Math.round(state.eco);$('mKnow').textContent=Math.round(state.know);$('mRes').textContent=Math.round(state.res);$('identity').textContent=identity();renderBars(scores,'scoreBars');renderBars({Water:state.water,Energy:state.energy,Food:state.food,Economy:state.econ,'Air quality':state.air},'resourceBars');renderBars({Housing:state.housing,'Land pressure':100-state.landPressure,Forest:state.forest,Biodiversity:state.biodiversity},'landBars');$('policyLab').innerHTML=policyHTML('energy');$('events').innerHTML=state.history.slice().reverse().map(h=>`<div class="event"><div class="event-year">${h.year}</div><div><h3>${esc(h.title)}</h3><p>${esc(h.desc)}</p><p><b>Cause:</b> ${esc(h.cause)} <b>Consequence:</b> ${esc(h.effect)}</p></div></div>`).join('');$('archiveCount').textContent=state.history.length+' recorded events';$('latestEvent').innerHTML=`<div class="event"><div class="event-year">${state.history.at(-1).year}</div><div><h3>${esc(state.history.at(-1).title)}</h3><p>${esc(state.history.at(-1).desc)}</p></div></div>`;$('achievements').innerHTML=state.achievements.map(a=>`<span class="btn" style="display:inline-block;margin:3px;border-color:var(--amber);color:var(--amber)">${esc(a)}</span>`).join('')||'<p class="notice">Your first achievement is waiting in the future.</p>';$('sideScores').innerHTML=Object.entries(scores).slice(0,6).map(([k,v])=>`<div class="score"><div class="score-head"><span>${k}</span><strong>${Math.round(v)}</strong></div><div class="track" style="margin-top:7px"><div class="fill" style="width:${v}%"></div></div></div>`).join('');$('originalCompare').innerHTML=Object.entries(scores).slice(0,6).map(([k,v])=>`<div class="bar-row" style="grid-template-columns:105px 1fr 28px;margin:10px 0"><span>${k}</span><div class="track"><div class="fill" style="width:${v}%"></div></div><b>${Math.round(v)}</b></div>`).join('');if(state.alt){$('altCompare').innerHTML=Object.entries(state.alt).map(([k,v])=>`<div class="bar-row" style="grid-template-columns:105px 1fr 28px;margin:10px 0"><span>${k}</span><div class="track"><div class="fill warn" style="width:${v}%"></div></div><b>${Math.round(v)}</b></div>`).join('');$('compareText').textContent='The alternative shifts the balance between ecology, knowledge, infrastructure and resilience. Neither profile is universally better; each expresses a different legacy.'}renderChoices();renderTimeline();renderTech();renderCanvas()}
function runWhatIf(){let s=calcScores(),a={...s};a.Ecology=clamp(s.Ecology+12);a.Knowledge=clamp(s.Knowledge+9);a.Infrastructure=clamp(s.Infrastructure-8);a.Resilience=clamp(s.Resilience+4);a.Livability=clamp(s.Livability+3);a['Resource security']=clamp(s['Resource security']-5);a.Adaptability=clamp(s.Adaptability+6);a['Long-term stability']=clamp((a.Ecology+a.Resilience+a.Knowledge+a.Infrastructure)/4);state.alt=a;achievements();save();render()}
function showView(v){document.querySelectorAll('.view').forEach(x=>x.classList.toggle('active',x.id===v));document.querySelectorAll('[data-view]').forEach(x=>x.classList.toggle('active',x.dataset.view===v))}
document.querySelectorAll('[data-view]').forEach(b=>b.addEventListener('click',()=>showView(b.dataset.view)));$('advanceBtn').onclick=advance;$('closeModal').onclick=()=>{$('modal').classList.remove('open');render()};$('saveBtn').onclick=save;$('newBtn').onclick=()=>{if(confirm('Start a new city? The current city remains in local storage.'))reset()};$('whatIfBtn').onclick=runWhatIf;$('cascadeSelect').onchange=renderCascade;window.addEventListener('resize',renderCanvas);document.addEventListener('keydown',e=>{if(e.key===' '){e.preventDefault();advance()}if(/^[1-5]$/.test(e.key)){let n=+e.key-1,idx=currentIndex(),key=idx===0?'growth':idx===1?'energy':idx===2?'water':idx===3?'food':idx===4?'transport':idx===5?'education':'prepared';if(POLICIES[key]?.[n])choose(key,n)}});load();render();
</script></body></html>
