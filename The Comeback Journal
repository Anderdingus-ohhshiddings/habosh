function setText(id,value){const node=$(id);if(node)node.textContent=value}function setHTML(id,value){const node=$(id);if(node)node.innerHTML=value}function updateDateLabels(){setText('monthLabel',new Intl.DateTimeFormat('en-US',{month:'long',year:'numeric'}).format(dateOf(today)).toUpperCase());setText('longDate',longDate(today));setText('dateNumber',dateOf(today).getDate());setText('dateMonth',new Intl.DateTimeFormat('en-US',{month:'short'}).format(dateOf(today)))}function scheduleMidnight(){clearTimeout(midnightTimer);const now=new Date(),next=new Date(now.getFullYear(),now.getMonth(),now.getDate()+1,0,0,0,80);midnightTimer=setTimeout(()=>{const fresh=iso(new Date());if(fresh!==today){today=fresh;calendarCursor=new Date(dateOf(today).getFullYear(),dateOf(today).getMonth(),1);updateDateLabels();render();toast('A new day has begun. Your check-ins are ready.')}scheduleMidnight()},Math.max(250,next.getTime()-now.getTime()))}function consistencyDays(){const first=new Date(calendarCursor.getFullYear(),calendarCursor.getMonth(),1),daysInMonth=new Date(first.getFullYear(),first.getMonth()+1,0).getDate(),offset=first.getDay(),cells=Array.from({length:offset},()=>'<span class="consistency-day blank"></span>'),currentMonth=calendarCursor.getFullYear()===dateOf(today).getFullYear()&&calendarCursor.getMonth()===dateOf(today).getMonth();for(let day=1;day<=daysInMonth;day++){const d=iso(new Date(first.getFullYear(),first.getMonth(),day)),due=habits.filter(h=>scheduled(h,d)),done=due.filter(h=>complete(h,d)),future=d>today,status=future?'upcoming':!due.length?'rest':done.length===due.length?'kept':'missed';cells.push(`<span class="consistency-day ${status} ${d===today?'today':''}" title="${longDate(d)} · ${future?'upcoming':status}">${day}</span>`)}return{label:new Intl.DateTimeFormat('en-US',{month:'long',year:'numeric'}).format(first),currentMonth,html:['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].map(d=>`<span class="consistency-weekday">${d.slice(0,2)}</span>`).join('')+cells.join('')}}function drawConsistency(){const c=consistencyDays();setText('consistencyLabel',c.label);setHTML('consistencyCalendar',c.html);const next=$('nextMonth');if(next)next.disabled=c.currentMonth}function changeMonth(offset){calendarCursor=new Date(calendarCursor.getFullYear(),calendarCursor.getMonth()+offset,1);drawConsistency()}function render(){const s=stats();setText('habitCount',s.due.length);setHTML('todayTitle',`Today’s habits <span id="habitCount">${s.due.length}</span>`);setHTML('habitList',habits.map(card).join(''));const empty=$('emptyState');if(empty)empty.style.display=habits.length?'none':'grid';const hint=$('dragHint');if(hint)hint.hidden=habits.length<2;setText('activeValue',String(habits.length).padStart(2,'0'));setText('activeNote',habits.length?`${s.due.length} planned today`:'Ready when you are');setText('rhythmValue',s.pct+'%');setText('rhythmNote',s.due.length?`${s.done.length} of ${s.due.length} kept`:'No habits scheduled');setText('bestValue',String(s.best).padStart(2,'0'));setText('bestNote',s.best===1?'day in a row':'days in a row');setText('introCopy',habits.length?quote(s.pct,true):'Build a rhythm that feels like yours, one small mark at a time.');setText('moodLabel',s.pct===100&&s.due.length?'Day well kept':'A little at a time');setText('quoteText',quote(s.pct,habits.length>0));setText('quoteLabel',habits.length?'A note for today':'A note for your first day');drawWeek();drawConsistency();bindCards()}
function drawWeek(){const w=week(),done=w.reduce((n,x)=>n+x.done,0),plan=w.reduce((n,x)=>n+x.plan,0);setText('weekDone',done);setText('weekPlanned',plan);setHTML('chart',w.map(x=>`<div class="column"><div class="track" title="${longDate(x.d)} · ${x.done} of ${x.plan} kept"><div class="bar" style="height:${x.plan?Math.max(10,x.done/Math.max(...w.map(a=>a.plan),1)*100):6}%">${x.done?'<b>'+x.done+'</b>':''}</div></div><span class="day ${x.d===today?'today':''}">${new Intl.DateTimeFormat('en-US',{weekday:'short'}).format(dateOf(x.d)).slice(0,2)}</span></div>`).join(''));}
function bindCards(){$$(' [data-action]'.trim()).forEach(b=>{b.onclick=e=>{const h=habits.find(x=>x.id===b.closest('.habit').dataset.id),a=b.dataset.action;if(a==='toggle')toggle(h);if(a==='edit')openEdit(h);if(a==='delete')del(h)}});$$('.habit').forEach(el=>{el.ondragstart=()=>dragged=el.dataset.id;el.ondragover=e=>e.preventDefault();el.ondrop=()=>drop(el.dataset.id)})}function $$(q){return document.querySelectorAll(q)}
function toggle(h){h.completions[today]=!h.completions[today];save();celebrate=h.id;render();setTimeout(()=>{celebrate=null;render()},500)}function del(h){if(confirm(`Delete “${h.name}”? Its check-in history will be removed.`)){habits=habits.filter(x=>x.id!==h.id);save();render();toast('Habit removed.')}}function clearAll(){if(confirm('Clear all habits and history? This cannot be undone.')){habits=[];save();render();$('sidebar').classList.remove('open');toast('All habit data was cleared.')}}function downloadApp(){const source='<!doctype html>\n'+document.documentElement.outerHTML;const url=URL.createObjectURL(new Blob([source],{type:'text/html;charset=utf-8'})),a=document.createElement('a');a.href=url;a.download='ritual-habit-tracker.html';document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),1000);toast('A portable copy is downloading.')}function drop(target){if(!dragged||dragged===target)return;let a=habits.findIndex(x=>x.id===dragged),b=habits.findIndex(x=>x.id===target),m=habits.splice(a,1)[0];habits.splice(b,0,m);save();dragged=null;render()}
function openAdd(){openForm('add')}function openEdit(h){openForm('edit',h)}function openForm(mode,h){modal=mode;editing=h?.id||null;const f=h||{name:'',icon:'✦',color:colors[0][1],frequency:'daily',weekdays:[1,2,3,4,5]};$('modalRoot').innerHTML=`<div class="modal-back" id="back"><section class="modal" role="dialog" aria-modal="true"><button class="modal-close icon" id="modalClose">×</button><div class="modal-kicker"><i class="dot" style="background:var(--coral)"></i>${mode==='add'?'New ritual':'Edit ritual'}</div><h2>${mode==='add'?'What do you want to keep?':'Tune the ritual'}</h2><p class="modal-intro">Give it a name that makes the next small step feel clear.</p><form id="habitForm"><label class="label">Habit name</label><input class="input" id="formName" required maxlength="42" placeholder="e.g. Walk before lunch" value="${esc(f.name)}"><div class="identity-form"><div><label class="label">Mark</label><input class="input icon-input" id="formIcon" maxlength="2" value="${esc(f.icon)}"></div><div><span class="label">Color note</span><div class="colors">${colors.map(c=>`<button type="button" class="color ${f.color===c[1]?'selected':''}" style="background:${c[1]}" data-color="${c[1]}" aria-label="${c[0]}"></button>`).join('')}</div></div></div><fieldset class="frequency"><legend class="label">Rhythm</legend><div class="frequency-options"><label class="freq ${f.frequency==='daily'?'selected':''}"><input type="radio" name="freq" value="daily" ${f.frequency==='daily'?'checked':''}><span>Every day</span><small>Keep it simple</small></label><label class="freq ${f.frequency==='weekdays'?'selected':''}"><input type="radio" name="freq" value="weekdays" ${f.frequency==='weekdays'?'checked':''}><span>Specific days</span><small>Choose a pattern</small></label></div></fieldset><div class="weekdays" id="weekdayBox" ${f.frequency==='daily'?'hidden':''}>${days.map(d=>`<button type="button" class="weekday ${f.weekdays.includes(d[2])?'selected':''}" data-day="${d[2]}"><b>${d[1]}</b><span>${d[0]}</span></button>`).join('')}</div><p class="error" id="formError" hidden>Choose at least one day for this rhythm.</p><div class="modal-foot"><button type="button" class="btn" id="cancelForm">Cancel</button><button class="btn primary">${mode==='add'?'Add habit':'Save changes'} ›</button></div></form></section></div>`;$('modalClose').onclick=closeModal;$('cancelForm').onclick=closeModal;$('back').onmousedown=e=>{if(e.target.id==='back')closeModal()};$('formName').focus();$$('[data-color]').forEach(b=>b.onclick=()=>{$$('[data-color]').forEach(x=>x.classList.remove('selected'));b.classList.add('selected')});$$('input[name=freq]').forEach(r=>r.onchange=()=>{$$('.freq').forEach(x=>x.classList.remove('selected'));r.closest('.freq').classList.add('selected');$('weekdayBox').hidden=r.value==='daily'});$$('[data-day]').forEach(b=>b.onclick=()=>b.classList.toggle('selected'));$('habitForm').onsubmit=e=>{e.preventDefault();const freq=document.querySelector('input[name=freq]:checked').value,wd=[...$$('#weekdayBox .selected')].map(x=>+x.dataset.day);if(freq==='weekdays'&&!wd.length){$('formError').hidden=false;return}const next={name:$('formName').value.trim()||'Untitled habit',icon:$('formIcon').value||'✦',color:document.querySelector('[data-color].selected').dataset.color,frequency:freq,weekdays:wd.length?wd:[1,2,3,4,5]};if(mode==='edit')habits=habits.map(x=>x.id===editing?{...x,...next}:x);else habits.push({...next,id:id(),completions:{},createdAt:today});save();closeModal();render();toast(mode==='edit'?'Habit updated.':'A new ritual was added.')}}
function closeModal(){$('modalRoot').innerHTML='';modal=null}function openWeek(){const w=week(),done=w.reduce((n,x)=>n+x.done,0),plan=w.reduce((n,x)=>n+x.plan,0),p=plan?Math.round(done/plan*100):0;$('modalRoot').innerHTML=`<div class="modal-back" id="back"><section class="modal week-modal"><button class="modal-close icon" id="modalClose">×</button><svg class="week-art" viewBox="0 0 360 150" fill="none" aria-hidden="true"><circle cx="282" cy="37" r="23" fill="#E3A63B"/><path d="M45 119c46-11 89-7 131-21 51-16 89-4 139-16" stroke="#1F2933" stroke-width="2" stroke-dasharray="5 8"/><path d="M67 111h42l-8 19H75l-8-19ZM154 91h42l-8 19h-26l-8-19ZM242 69h42l-8 19h-26l-8-19Z" fill="#E56B55"/><path d="M88 105v-22M175 86V62M263 64V40" stroke="#7D9A83" stroke-width="6" stroke-linecap="round"/></svg><div class="modal-kicker">✦ Week in review</div><h2>You kept ${done} of ${plan} moments.</h2><div class="score"><strong>${p}%</strong><span>of your planned week</span></div><p class="modal-intro">${quote(p,habits.length>0)}</p><div class="mini-chart"><div class="chart">${$('chart').innerHTML}</div></div><button class="btn primary" id="modalClose2" style="width:100%">Back to today ›</button></section></div>`;$('modalClose').onclick=closeModal;$('modalClose2').onclick=closeModal;$('back').onmousedown=e=>{if(e.target.id==='back')closeModal()}}
function toast(msg){$('toastRoot').innerHTML=`<div class="toast"><span class="toast-check">✓</span>${msg}</div>`;setTimeout(()=>{$('toastRoot').innerHTML=''},3000)}
function exportData(){const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([JSON.stringify({exportedAt:new Date().toISOString(),app:'Ritual Habit Tracker',habits},null,2)],{type:'application/json'}));a.download='ritual-habits-'+today+'.json';a.click();toast('Your habit journal was exported.')}function importData(file){const r=new FileReader();r.onload=()=>{try{const x=JSON.parse(r.result);if(!Array.isArray(x.habits))throw Error();habits=x.habits.map(cleanHabit);save();render();toast('Your habit journal was restored.')}catch(e){toast('That file could not be read as a Ritual journal.')}};r.readAsText(file)}
function themeSet(persist=true){document.documentElement.dataset.theme=theme;if(persist)localStorage.setItem(THEME,theme);$('themeLabel').textContent=theme==='light'?'Night ink':'Daylight';$('themeState').textContent=theme==='light'?'off':'on';$('themeIcon').textContent=theme==='light'?'◐':'☼'}
window.addEventListener('storage',event=>{if(event.key===KEY){habits=load();render();toast('This journal changed in another tab.')}if(event.key===THEME&&event.newValue){theme=event.newValue==='dark'?'dark':'light';themeSet(false)}});window.addEventListener('pageshow',()=>{habits=load();render()});
updateDateLabels();themeSet();render();scheduleMidnight();$('addTop').onclick=openAdd;$('emptyAdd').onclick=openAdd;$('weekBtn').onclick=openWeek;$('prevMonth').onclick=()=>changeMonth(-1);$('nextMonth').onclick=()=>changeMonth(1);$('clearBtn').onclick=clearAll;$('downloadBtn').onclick=downloadApp;$('downloadMenuBtn').onclick=()=>{downloadApp();$('sidebar').classList.remove('open')};$('themeBtn').onclick=()=>{theme=theme==='light'?'dark':'light';themeSet()};$('menuBtn').onclick=()=>$('sidebar').classList.add('open');$('closeMenu').onclick=()=>$('sidebar').classList.remove('open');$('insightsNav').onclick=()=>{$('insights').scrollIntoView({behavior:'smooth'});$('sidebar').classList.remove('open')};$('todayNav').onclick=()=>window.scrollTo({top:0,behavior:'smooth'});document.addEventListener('keydown',e=>e.key==='Escape'&&closeModal());
</script>
