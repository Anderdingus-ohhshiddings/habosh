const KEY='ritual-habits-v1',THEME='ritual-theme-v1',colors=[['Marigold','#E3A63B','#F8EBCB'],['Coral','#E56B55','#F8D9D1'],['Sage','#7D9A83','#DDE8DD'],['Blue ink','#5E7D99','#DDE6EF'],['Plum','#8E6D83','#E9DDE5']],days=[['Sun','S',0],['Mon','M',1],['Tue','T',2],['Wed','W',3],['Thu','T',4],['Fri','F',5],['Sat','S',6]],quotes=[[0,'Start with one small promise. The rest can follow.'],[30,'A small mark in the day still counts.'],[60,'You are making a rhythm you can return to.'],[80,'You’re keeping a beautiful rhythm. Keep it gentle.'],[100,'A clear day, well kept. Notice how far you’ve come.']];
const $=id=>document.getElementById(id);let today=(()=>{const d=new Date();return iso(d)})();let midnightTimer=null;
function iso(d){return [d.getFullYear(),String(d.getMonth()+1).padStart(2,'0'),String(d.getDate()).padStart(2,'0')].join('-')}function dateOf(s){return new Date(s+'T12:00:00')}function shift(s,n){const d=dateOf(s);d.setDate(d.getDate()+n);return iso(d)}function dayNum(s){return dateOf(s).getDay()}function longDate(s){return new Intl.DateTimeFormat('en-US',{weekday:'long',month:'long',day:'numeric'}).format(dateOf(s))}function id(){return Date.now()+'-'+Math.random().toString(16).slice(2)}
function cleanHabit(h,i){const raw=h&&typeof h==='object'?h:{},rawId=String(raw.id||''),safeId=/^[A-Za-z0-9_-]{1,80}$/.test(rawId)?rawId:id(),name=String(raw.name||'Untitled habit').slice(0,42),icon=Array.from(String(raw.icon||'✦')).slice(0,2).join('')||'✦',color=colors.some(c=>c[1]===raw.color)?raw.color:colors[i%colors.length][1],frequency=raw.frequency==='weekdays'?'weekdays':'daily',picked=Array.isArray(raw.weekdays)?raw.weekdays.map(Number).filter(n=>Number.isInteger(n)&&n>=0&&n<=6):[],weekdays=[...new Set(picked)].length?[...new Set(picked)]:[1,2,3,4,5],createdAt=/^\d{4}-\d{2}-\d{2}$/.test(String(raw.createdAt||''))?String(raw.createdAt):today,completions={};if(raw.completions&&typeof raw.completions==='object')Object.entries(raw.completions).slice(0,730).forEach(([date,value])=>{if(/^\d{4}-\d{2}-\d{2}$/.test(date)&&value===true)completions[date]=true});return{id:safeId,name,icon,color,frequency,weekdays,completions,createdAt}}function load(){try{const x=JSON.parse(localStorage.getItem(KEY)||'[]');return Array.isArray(x)?x.map(cleanHabit):[]}catch(e){return[]}}
let habits=load(),theme=localStorage.getItem(THEME)||'light',modal=null,editing=null,celebrate=null,dragged=null,calendarCursor=new Date(dateOf(today).getFullYear(),dateOf(today).getMonth(),1);
function save(){localStorage.setItem(KEY,JSON.stringify(habits))}function scheduled(h,d){return d>=h.createdAt&&(h.frequency==='daily'||h.weekdays.includes(dayNum(d)))}function complete(h,d){return !!h.completions[d]}function streak(h,from){let n=0,d=from;for(let i=0;i<730;i++){if(d<h.createdAt)break;if(!scheduled(h,d)){d=shift(d,-1);continue}if(!complete(h,d))break;n++;d=shift(d,-1)}return n}function longest(h){let n=0,r=0,d=h.createdAt;for(let i=0;i<730&&d<=today;i++){if(scheduled(h,d)){if(complete(h,d)){r++;n=Math.max(n,r)}else r=0}d=shift(d,1)}return n}function stats(){const due=habits.filter(h=>scheduled(h,today)),done=due.filter(h=>complete(h,today)),pct=due.length?Math.round(done.length/due.length*100):0;return{due,done,pct,best:habits.reduce((n,h)=>Math.max(n,streak(h,today)),0)}}function week(){return Array.from({length:7},(_,i)=>{const d=shift(today,i-6),plan=habits.filter(h=>scheduled(h,d)).length,done=habits.filter(h=>scheduled(h,d)&&complete(h,d)).length;return{d,plan,done}})}function quote(p,has){if(!has)return quotes[0][1];return [...quotes].reverse().find(x=>p>=x[0])[1]}
